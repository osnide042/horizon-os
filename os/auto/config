#!/bin/sh
set -e
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --image-name mrrobot-os \
  --iso-application "MR.ROBOT OS" \
  --iso-publisher "MR.ROBOT Studios" \
  --iso-volume "MRROBOT_OS" \
  --debian-installer live \
  --debian-installer-gui true \
  --security false \
  --archive-areas "main contrib non-free-firmware" \
  --bootappend-live "boot=live components username=mrrobot hostname=mrrobot-os locales=en_GB.UTF-8 keyboard-layouts=gb quiet splash loglevel=3 vt.global_cursor_default=0"
