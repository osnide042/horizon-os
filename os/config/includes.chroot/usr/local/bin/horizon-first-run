#!/bin/sh
set -eu
[ -e /var/lib/horizon/state/device.json ] && exit 0
counter=0
while [ "$counter" -lt 40 ]; do
  curl -fsS http://127.0.0.1:4782/api/system >/dev/null 2>&1 && break
  counter=$((counter + 1))
  sleep 0.25
done
chromium --password-store=basic --user-data-dir="$HOME/.config/horizon-setup" --app=http://127.0.0.1:4782/ --start-maximized --no-first-run --disable-session-crashed-bubble &
browser_pid=$!
while kill -0 "$browser_pid" 2>/dev/null; do
  if [ -e /var/lib/horizon/state/device.json ]; then
    kill "$browser_pid" 2>/dev/null || true
    break
  fi
  sleep 1
done
