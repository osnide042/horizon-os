Window.SetBackgroundTopColor(0.015, 0.025, 0.09);
Window.SetBackgroundBottomColor(0.16, 0.025, 0.30);

logo = Image("horizon-mark.png");
glow = logo.Scale(190, 190);
glow_sprite = Sprite(glow);
glow_sprite.SetX(Window.GetWidth() / 2 - 95);
glow_sprite.SetY(Window.GetHeight() / 2 - 142);
glow_sprite.SetOpacity(0.18);

logo_sprite = Sprite(logo);
logo_sprite.SetZ(10);

title = Image.Text("H O R I Z O N", 0.96, 0.97, 1.0);
title_sprite = Sprite(title);
title_sprite.SetX(Window.GetWidth() / 2 - title.GetWidth() / 2);
title_sprite.SetY(Window.GetHeight() / 2 + 62);
title_sprite.SetZ(10);

status = Image.Text("STARTING YOUR DESKTOP", 0.42, 0.72, 1.0);
status_sprite = Sprite(status);
status_sprite.SetX(Window.GetWidth() / 2 - status.GetWidth() / 2);
status_sprite.SetY(Window.GetHeight() / 2 + 108);
status_sprite.SetZ(10);

ring = Image.Text("·   ·   ·", 0.50, 0.35, 1.0);
ring_sprite = Sprite(ring);
ring_sprite.SetY(Window.GetHeight() / 2 + 142);
ring_sprite.SetZ(10);

fun horizon_refresh() {
  t = Plymouth.GetTime();
  spin = Math.Sin(t * 2.8);
  if (spin < 0) spin = 0 - spin;
  width = 25 + spin * 135;
  frame = logo.Scale(width, 160);
  logo_sprite.SetImage(frame);
  logo_sprite.SetX(Window.GetWidth() / 2 - width / 2);
  logo_sprite.SetY(Window.GetHeight() / 2 - 128);
  glow_sprite.SetOpacity(0.12 + (Math.Sin(t * 2.0) + 1.0) * 0.08);
  ring_sprite.SetX(Window.GetWidth() / 2 - ring.GetWidth() / 2 + Math.Sin(t * 3.2) * 8);
  ring_sprite.SetOpacity(0.45 + (Math.Sin(t * 4.0) + 1.0) * 0.25);
}

Plymouth.SetRefreshFunction(horizon_refresh);
