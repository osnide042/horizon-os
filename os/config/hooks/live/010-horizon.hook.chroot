#!/bin/sh
set -e
chmod +x /usr/local/bin/horizon-session /usr/local/lib/horizon/api.py
id horizon >/dev/null 2>&1 || useradd -m -s /bin/bash horizon
usermod -aG audio,video horizon
systemctl enable horizon-api.service
systemctl enable lightdm.service
mkdir -p /var/lib/horizon/games /var/lib/horizon/state
chown -R horizon:horizon /var/lib/horizon 2>/dev/null || true
